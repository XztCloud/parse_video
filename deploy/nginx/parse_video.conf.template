# parse_video nginx 站点配置模板（反向代理 + HTTPS）
#
# 完整步骤与踩坑记录见 docs/deploy-nginx-https.md，这里只列最短路径：
#
#   1. 全局替换占位符 __DOMAIN__ → 你的域名（例如 www.example.com）
#   2. cp parse_video.conf.template     /etc/nginx/conf.d/parse_video.conf
#      cp parse_video_proxy.conf        /etc/nginx/snippets/parse_video_proxy.conf
#   3. 注释掉发行版自带的默认站点。它是 80 的 default_server 且指向
#      /usr/share/nginx/html，不注释掉的话用 IP 访问会落到 nginx 欢迎页：
#        sed -i '37,53 s/^/#/' /etc/nginx/nginx.conf    # 行号以实际文件为准，先 diff 确认
#   4. nginx -t && systemctl enable --now nginx
#
# 前提：前端容器必须绑到回环地址，即 .env 里设 FRONTEND_BIND=127.0.0.1:3000，
# 否则容器会抢占 80 端口，和 nginx 冲突导致前端容器起不来。

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# 默认 server：用 IP 或未匹配的 Host 访问时保持明文反代，不做跳转
server {
    listen       80 default_server;
    listen       [::]:80 default_server;
    server_name  _;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        include /etc/nginx/snippets/parse_video_proxy.conf;
    }
}

# 域名：80 全部跳转 HTTPS
# 注意保留 ACME 校验路径——证书续期走的是 80，跳转不能把它一起盖掉
server {
    listen       80;
    listen       [::]:80;
    server_name  __DOMAIN__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 域名：443 TLS
server {
    listen       443 ssl http2;
    listen       [::]:443 ssl http2;
    server_name  __DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    location / {
        include /etc/nginx/snippets/parse_video_proxy.conf;
    }
}
